# Template .env untuk docker-compose.prod.yml.
#
# Salin ke `.env` DI SERVER (di SERVER_APP_DIR, sebelah docker-compose.prod.yml)
# lalu isi nilainya. File .env tidak pernah ikut ter-commit maupun di-scp oleh
# workflow — ia dikelola manual di server.
#
# Config backend dibaca viper dengan prefix HRIS_ dan "." → "_"
# (internal/pkg/config/config.go:247-249), jadi `database.platform_host`
# menjadi HRIS_DATABASE_PLATFORM_HOST. Env selalu menang atas config.yaml.

# ===================================================================
# Image — dipakai compose, bukan aplikasi
# ===================================================================
# Harus cocok dengan yang di-push workflow: ghcr.io/<owner-github>
IMAGE_PREFIX=ghcr.io/inthros
IMAGE_TAG=latest

# Port yang di-publish ke host untuk kedua frontend.
TENANT_WEB_PORT=8090
ADMIN_WEB_PORT=8091

# ===================================================================
# Database — PostgreSQL di dalam compose
# ===================================================================
# HRIS_DATABASE_PLATFORM_DB / _USER / _PASSWORD dipakai DUA KALI:
#   1. oleh service postgres untuk membuat database + superuser saat pertama
#      kali volume diinisialisasi (POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD)
#   2. oleh api untuk connect ke platform DB
# Jadi cukup diisi sekali di sini, tidak ada nilai yang perlu disamakan manual.
#
# PENTING: user & password hanya dibuat saat direktori data/postgres masih kosong.
# Mengubahnya setelah database terisi tidak akan mengubah apa pun di postgres,
# hanya membuat api gagal login.
HRIS_DATABASE_DRIVER=postgres

# `postgres` = nama service di docker-compose.prod.yml, bukan hostname server.
HRIS_DATABASE_PLATFORM_HOST=postgres
HRIS_DATABASE_PLATFORM_PORT=5432
HRIS_DATABASE_PLATFORM_DB=hris_platform
HRIS_DATABASE_PLATFORM_USER=hris
HRIS_DATABASE_PLATFORM_PASSWORD=

# Provisioning database tenant baru (butuh privilege CREATE DATABASE).
# POSTGRES_USER bawaan image postgres sudah superuser, jadi isi dengan
# user & password yang sama seperti platform di atas.
HRIS_DATABASE_TENANT_HOST=postgres
HRIS_DATABASE_TENANT_PORT=5432
HRIS_DATABASE_TENANT_SUPER_USER=hris
HRIS_DATABASE_TENANT_SUPER_PASSWORD=

# Trafik postgres tidak pernah keluar dari network internal compose dan
# portnya tidak di-publish, jadi TLS tidak diperlukan di sini.
HRIS_DATABASE_PLATFORM_SSLMODE=disable
HRIS_DATABASE_TENANT_SSLMODE=disable

# ===================================================================
# Secrets — WAJIB diganti
# ===================================================================
# Kunci AES-256-GCM untuk mengenkripsi kredensial DB tenant di platform DB.
# 32-byte hex = tepat 64 karakter. Generate: openssl rand -hex 32
#
# Dibaca langsung lewat os.Getenv oleh internal/pkg/crypto (bukan viper), jadi
# namanya persis HRIS_ENCRYPTION_KEY tanpa mapping.
#
# JANGAN dirotasi tanpa rencana migrasi: kredensial tenant yang sudah
# terenkripsi tidak akan bisa didekripsi lagi.
HRIS_ENCRYPTION_KEY=

HRIS_JWT_SECRET=
HRIS_JWT_ACCESS_TOKEN_TTL=15
HRIS_JWT_REFRESH_TOKEN_TTL=24

# ===================================================================
# SMTP — email transaksional (mis. link set-password employee)
# ===================================================================
# Default config.yaml mengarah ke Mailpit lokal; di produksi Mailpit tidak
# ikut di-deploy, jadi ini WAJIB diisi relay sungguhan (SES/Resend/Mailgun)
# atau email tidak akan pernah terkirim.
HRIS_SMTP_HOST=
HRIS_SMTP_PORT=587
HRIS_SMTP_USERNAME=
HRIS_SMTP_PASSWORD=
HRIS_SMTP_FROM=no-reply@example.com

# URL publik app tenant — dipakai untuk menyusun link di dalam email.
HRIS_SMTP_FRONTEND_BASE_URL=https://hris.example.com

# ===================================================================
# Lisensi
# ===================================================================
HRIS_LICENSE_DEPLOYMENT_MODE=saas
# Saat on_premise, kedua file di bawah harus ada di dalam container:
# HRIS_LICENSE_LICENSE_FILE=./config/license.lic
# HRIS_LICENSE_PUBLIC_KEY_FILE=./config/license_public.pem

# ===================================================================
# Catatan: yang TIDAK bisa diatur dari sini
# ===================================================================
# cors.allowed_origins / allowed_methods / allowed_headers berupa []string.
# viper.Unmarshal tidak memecah string env menjadi slice, jadi
# HRIS_CORS_ALLOWED_ORIGINS="a,b" tidak akan bekerja seperti yang diharapkan.
# Ubah nilainya di backend/config/config.yaml lalu rebuild image.
#
# Dalam setup ini kedua frontend diserve satu origin dengan API lewat nginx
# (/api di-proxy ke service api), sehingga request browser bersifat same-origin
# dan CORS tidak menjadi jalur utama.
