# =============================================================================
# HRIS Platform — Root .gitignore
# =============================================================================

# === Build Artifacts ===
backend/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# === Test Artifacts ===
backend/coverage.out
backend/coverage.html
backend/test-output.log
*.test
*.test.exe

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# === Environment ===
.env
backend/.env
*.log

# === Go ===
vendor/

# === Docker ===
backend/docker/.dockerignore

# === Miscellaneous ===
tmp/
temp/

# === Docs — folder yang DIABAIKAN (jangan di-indeks git/tooling) ===
# Lihat docs/README.md → "Folder yang Diabaikan".
docs/tmp/
docs/archive/
docs/backlog/
docs/seeder/

# Dependencies
frontend/platform-admin/node_modules
frontend/tenant/node_modules

# === Python ===
__pycache__/
*.pyc
# runtime uploads (attachment files)
backend/uploads/

# Superpowers subagent-driven-development scratch workspace
.superpowers/
